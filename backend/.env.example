# -------------------------
# Server Configuration
# -------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# -------------------------
# Database Configuration
# -------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apartment_management
DB_USER=postgres
DB_PASSWORD=daveski024

# -------------------------
# JWT Configuration
# -------------------------
JWT_SECRET=super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# -------------------------
# Email Configuration
# -------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=jnlapartmentmanagement@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_SECURE=tls
EMAIL_FROM=jnlapartmentmanagement@gmail.com
EMAIL_FROM_NAME=JNL Apartment Management
EMAIL_REPLY_TO=jnlapartmentmanagement@gmail.com
EMAIL_ALERT_TO=jnlapartmentmanagement@gmail.com
# Account activation link lifetime in minutes (default 48 hours)
ACTIVATION_LINK_EXPIRE_MINUTES=2880

# -------------------------
# Payment Gateway
# -------------------------
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLIC_KEY=pk_test_your_key
GCASH_API_KEY=your_gcash_key
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
SERVER_URL=http://localhost:5000

# -------------------------
# ML/AI Services
# -------------------------
PYTHON_FORECAST_SERVICE=http://localhost:5001
CHATBOT_API_KEY=your_chatbot_api_key

# -------------------------
# Meralco Rates Source (Optional)
# -------------------------
# Leave blank to use fallback rates only.
# Example: MERALCO_API_URL=https://your-meralco-rates-api.example.com/rates
MERALCO_API_URL=
# Optional comma-separated backup URLs
MERALCO_API_URLS=
# Set to true to fully disable remote rate fetching and always use fallback/cache
MERALCO_DISABLE_REMOTE=false
# Meralco source request timeout in milliseconds (default 45 seconds)
MERALCO_API_TIMEOUT_MS=45000
# Cache TTL in milliseconds (default 30 days to match monthly Meralco updates)
MERALCO_CACHE_TTL_MS=2592000000
# Retry cooldown after repeated 404 failures (default 6 hours)
MERALCO_RETRY_COOLDOWN_MS=21600000
# During cooldown, print at most one "cooldown active" log per interval (default 60s)
MERALCO_COOLDOWN_LOG_INTERVAL_MS=60000

# -------------------------
# AWS/Storage (Optional)
# -------------------------
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=your_bucket_name

# -------------------------
# Frontend API Access
# -------------------------
REACT_APP_API_URL=http://localhost:5000
